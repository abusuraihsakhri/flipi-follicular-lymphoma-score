{
  "openapi": "3.1.0",
  "info": {
    "title": "Flipi Follicular Lymphoma Score API",
    "description": "Classical FLIPI scoring and optional generic audit/supervisor endpoints. The generated FastAPI schema at /openapi.json is authoritative.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON summary of in-process audit and task counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return a clearly labeled deterministic mock response (no clinical inference)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/flipi": {
      "post": {
        "summary": "Calculate the classical five-factor FLIPI score",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "age",
                  "stage",
                  "hemoglobin",
                  "ldh_ratio",
                  "nodal_sites"
                ],
                "properties": {
                  "age": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "stage": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "hemoglobin": {
                    "type": "number",
                    "minimum": 0
                  },
                  "ldh_ratio": {
                    "type": "number",
                    "minimum": 0
                  },
                  "nodal_sites": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "FLIPI score, risk group and historical cohort survival figures"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    }
  }
}
